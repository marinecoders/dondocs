    "ackVer": {
      "type": "checkbox",
      "label": " 20. The command approving official must verify member is currently working, and has experience, in the position for which the credential is tied to.\n* Command Approving Official must be Command IAM (for IA voucher), or Command Career Counselor, or E7 or above, or DON Civil Service designated by the Commanding Officer.",
      "page": 2,
      "box": {
