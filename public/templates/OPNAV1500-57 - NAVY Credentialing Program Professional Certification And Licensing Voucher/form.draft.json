        "width": 10.0,
        "height": 10.0
      }
    },
    "ackDup": {
      "type": "checkbox",
      "label": "The member must not have received exam funding from any other source that would constitute a duplication of payment, such as, GI Bill, local Command funding, or DANTES.",
      "page": 2,
      "box": {
        "left": 556.5,
        "top": 425.7,
        "width": 10.0,
        "height": 10.0
      }
    },
    "ackVer2": {
      "type": "checkbox",
      "label": " 22. The member has reviewed the credentialing agency's Web site and verified that he/she has met all the agency's pre-requisites, application requirements, education, and experience requirements to be eligible for the exam.",
      "page": 2,
      "box": {
        "left": 285.9,
        "top": 425.6,
        "width": 10.0,
        "height": 10.0
      }
    },
    "aclRec": {
      "type": "checkbox",
      "label": " 24. The Navy Credentials Program Office must receive the voucher\nrequest from the member of command approving Official - NO LESS\nTHAN seven (7) business days PRIOR to the exam date.\n - Exceptions may be reviewed on a case-by-case basis.",
      "page": 2,
