{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts", "vite.companion.config.ts", "vite.companion-app.config.ts", "playwright.config.ts", "playwright.browser.config.ts", "playwright.releases.config.ts", "scripts/retained-releases.ts", "scripts/prepare-release.ts", "scripts/release-qualification.ts", "scripts/check-release-qualification.ts", "scripts/capture-legacy*.ts", "scripts/verify-live-release.ts", "scripts/serve-release.ts"]
}
