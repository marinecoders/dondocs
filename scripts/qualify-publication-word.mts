import { mkdtemp, readFile, rename, rm, stat, writeFile } from 'node:fs/promises';
import { join, resolve } from 'node:path';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import JSZip from 'jszip';
import { publicationWordFixtures } from '../tests/_helpers/publicationWordQualification';
import { verifyPublicationWordInputs } from './publication-word-receipts';
import { inspectPrintedContentsLabels, inspectPublicationContentsDestinations, inspectPublicationWordNavigation, inspectPublicationWordRender, publicationWordPageSizes, type PublicationWordRenderer } from './publication-word-renders';

const [directory, renderer, version] = process.argv.slice(2);
if (!directory || !['microsoft-word', 'libreoffice'].includes(renderer) || !version?.trim() || process.argv.length !== 5) {
  throw new Error('Usage: vite-node --config vitest.config.ts scripts/qualify-publication-word.mts DIRECTORY microsoft-word|libreoffice RENDERER_VERSION');
}
const output = resolve(directory);
const manifest = await verifyPublicationWordInputs(output);
const digest = (bytes: Uint8Array): string => createHash('sha256').update(bytes).digest('hex');
const command = (name: string, args: string[], input: Buffer): string =>
  execFileSync(name, args, { input, encoding: 'utf8', timeout: 30_000, maxBuffer: 16 * 1024 * 1024 });
const maxPrintBytes = 64 * 1024 * 1024;
async function readPrint(path: string) {
  const size = (await stat(path)).size;
  if (size > maxPrintBytes) throw new Error('The retained print exceeds 64 MB.');
  const bytes = await readFile(path);
  if (bytes.byteLength !== size) throw new Error('The retained print changed while being read.');
  return bytes;
}
const expectedPageReferences = new Map(publicationWordFixtures().map(fixture => [fixture.name, fixture.expectedPageReferences ?? 0]));
const receipts = [];
for (const fixture of manifest.fixtures) {
  const docx = await readFile(join(output, `${fixture.name}.docx`));
  if (digest(docx) !== fixture.docxSha256) throw new Error(`${fixture.name}: the DOCX changed before inspection.`);
  const zip = await JSZip.loadAsync(docx);
  const xml = await zip.file('word/document.xml')?.async('string');
  if (!xml) throw new Error(`${fixture.name}: the source has no Word document part.`);
  const { contentsEntries, ...navigation } = inspectPublicationWordNavigation(xml);
  if (navigation.pageReferences !== expectedPageReferences.get(fixture.name)) {
    throw new Error(`${fixture.name}: the publication has missing or additional contents page fields.`);
  }
  const path = join(output, `${fixture.name}-${renderer}.pdf`);
  const bytes = await readPrint(path);
  const metadata = command('pdfinfo', ['-'], bytes);
  const boundingBoxes = command('pdftotext', ['-bbox-layout', '-', '-'], bytes);
  const inspection = inspectPublicationWordRender({ renderer: renderer as PublicationWordRenderer, metadata,
    boundingBoxes, markers: fixture.markers, pageSizes: publicationWordPageSizes(xml) });
  const printedContentsLabels = contentsEntries.length
    ? await inspectPublicationContentsDestinations(bytes, boundingBoxes,
      inspectPrintedContentsLabels(command('pdftotext', ['-layout', '-', '-'], bytes), contentsEntries)) : [];
  receipts.push({ name: fixture.name, sourceSha256: fixture.sourceSha256, docxSha256: fixture.docxSha256,
    printedPdfSha256: digest(bytes), ...inspection, navigation, printedContentsLabels });
}
// Recheck source and generated bytes after reading all prints. Publish a receipt
// only for a complete passing set; a failed run cannot partly stamp a family.
const verified = await verifyPublicationWordInputs(output);
if (JSON.stringify(verified) !== JSON.stringify(manifest)) throw new Error('The publication source manifest changed during inspection.');
for (const receipt of receipts) {
  if (digest(await readPrint(join(output, `${receipt.name}-${renderer}.pdf`))) !== receipt.printedPdfSha256) {
    throw new Error(`${receipt.name}: the print changed during inspection.`);
  }
}
const receipt = { kind: 'publication-word-measured-renders', renderer, version, inspectedAt: new Date().toISOString(),
  family: manifest.family,
  nativeEditSaveQualified: false, visualReviewRequired: true,
  rendererSources: manifest.rendererSources, fixtures: receipts };
const path = join(output, `${renderer}-renders.json`);
const staging = await mkdtemp(join(output, '.word-render-'));
try {
  const file = join(staging, 'receipt.json');
  await writeFile(file, `${JSON.stringify(receipt, null, 2)}\n`);
  await rename(file, path);
} finally {
  await rm(staging, { recursive: true, force: true });
}
const findings = receipts.flatMap(receipt => receipt.printedContentsLabels
  .filter(row => row.result !== 'matches-format' || row.destinationCheck !== 'matches')
  .map(row => `${receipt.name}: ${row.label} (format: ${row.result}; destination: ${row.destinationCheck})`));
console.log(`Measured ${receipts.length} ${renderer} publication prints. Contents label findings: ${findings.length}.`);
for (const finding of findings) console.log(finding);
