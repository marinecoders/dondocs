# =============================================================================
# DONDOCS .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Build-time vendored binaries (downloaded by scripts/vendor-assets.mjs)
# -----------------------------------------------------------------------------
# pandoc.wasm is ~58 MB; committing it would nearly triple the repo and live in
# history forever. It is fetched on postinstall/prebuild and baked into dist/,
# so the deployed (air-gapped) artifact is self-contained while the repo stays
# lean. The small WASI shim + pdfjs 3.11 worker ARE committed (see public/lib/).
public/lib/pandoc/pandoc.wasm
public/lib/pandoc/*.partial

# -----------------------------------------------------------------------------
# LaTeX Build Artifacts
# -----------------------------------------------------------------------------
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Generated PDF (compile locally)
main.pdf

# -----------------------------------------------------------------------------
# User Data & Sensitive Files (do not commit)
# -----------------------------------------------------------------------------

# Enclosures - add your own PDFs locally
enclosures/*.pdf

# Forms - working PDFs
forms/*.pdf

# Attachments - signatures, seals
attachments/signature.png
attachments/signature.jpg
attachments/signature.pdf

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------

# Claude Code
.claude/


# Large binary assets (fetched at runtime / cached by service worker)
public/lib/pandoc/pandoc.wasm

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (if ever added)
__pycache__/
*.pyc
.env
venv/

# Classification configuration (keep example, ignore actual config)
public/classification.config.json

# Local audit findings (multi-agent code audit output — kept local, not shipped)
.audit-findings/

# -----------------------------------------------------------------------------
# Test & Debug Files
# -----------------------------------------------------------------------------
test-*.js
*.test.js
debug-*.log
coverage/
.pairwise-run.log
.cartesian-results/
.stryker-results/
.stryker-tmp/
