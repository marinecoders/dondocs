# =============================================================================
# DONDOCS .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# LaTeX Build Artifacts
# -----------------------------------------------------------------------------
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Generated PDF (compile locally)
main.pdf

# -----------------------------------------------------------------------------
# User Data & Sensitive Files (do not commit)
# -----------------------------------------------------------------------------

# Enclosures - add your own PDFs locally
enclosures/*.pdf

# Forms - working PDFs
forms/*.pdf

# Attachments - signatures, seals
attachments/signature.png
attachments/signature.jpg
attachments/signature.pdf

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------

# Claude Code
.claude/


# Build-time vendored binaries (downloaded + split by scripts/vendor-assets.mjs;
# baked into dist/ so the deployed artifact is air-gap self-contained)
public/lib/pandoc/pandoc.wasm
public/lib/pandoc/pandoc.wasm.part*
public/lib/pandoc/pandoc.wasm.manifest.json
public/lib/pandoc/*.partial

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (if ever added)
__pycache__/
*.pyc
.env
venv/

# Classification configuration (keep example, ignore actual config)
public/classification.config.json

# -----------------------------------------------------------------------------
# Test & Debug Files
# -----------------------------------------------------------------------------
test-*.js
*.test.js
debug-*.log
coverage/
.pairwise-run.log
.cartesian-results/
.stryker-results/
.stryker-tmp/

# Generated PWA/Apple icons — rasterized from public/icon.svg by
# scripts/generate-icons.mjs on predev/prebuild (one source of truth).
public/apple-touch-icon.png
public/pwa-192.png
public/pwa-512.png
public/pwa-maskable-512.png

# Generated supply-chain artifact (npm run sbom); produced fresh in CI.
sbom.cdx.json
companion-out.pdf
