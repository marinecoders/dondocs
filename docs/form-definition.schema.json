{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "formId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "definitionRevision": {
      "type": "string",
      "minLength": 1
    },
    "templateRevision": {
      "type": "string",
      "minLength": 1
    },
    "directory": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\.pdf$"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "identifier",
              "date",
              "decimal",
              "boolean",
              "singleChoice",
              "multipleChoice",
              "signature"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requiredAt": {
            "type": "string",
            "enum": [
              "export",
              "sign"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "legacyKey": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "multiline": {
            "type": "boolean"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "legacyKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "optionId": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "box": {
            "type": "object",
            "properties": {
              "left": {
                "type": "number",
                "minimum": 0
              },
              "top": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "left",
              "top",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "appearance": {
            "type": "string",
            "enum": [
              "text",
              "mark"
            ]
          },
          "overflow": {
            "default": "shrink",
            "type": "string",
            "enum": [
              "error",
              "shrink"
            ]
          },
          "dateFormat": {
            "type": "string",
            "enum": [
              "iso",
              "mdy",
              "dmy"
            ]
          }
        },
        "required": [
          "fieldId",
          "page",
          "box",
          "appearance",
          "overflow"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "editor": {
            "type": "string",
            "enum": [
              "list",
              "checklist"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "rowGroups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "identifier",
                    "date",
                    "decimal",
                    "boolean",
                    "singleChoice",
                    "multipleChoice",
                    "signature"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "requiredAt": {
                  "type": "string",
                  "enum": [
                    "export",
                    "sign"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "legacyKey": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "multiline": {
                  "type": "boolean"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "legacyKeys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "legacyKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "minItems": 1,
            "type": "array",
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fieldId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "optionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "box": {
                    "type": "object",
                    "properties": {
                      "left": {
                        "type": "number",
                        "minimum": 0
                      },
                      "top": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "left",
                      "top",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "appearance": {
                    "type": "string",
                    "enum": [
                      "text",
                      "mark"
                    ]
                  },
                  "overflow": {
                    "default": "shrink",
                    "type": "string",
                    "enum": [
                      "error",
                      "shrink"
                    ]
                  },
                  "dateFormat": {
                    "type": "string",
                    "enum": [
                      "iso",
                      "mdy",
                      "dmy"
                    ]
                  }
                },
                "required": [
                  "fieldId",
                  "page",
                  "box",
                  "appearance",
                  "overflow"
                ],
                "additionalProperties": false
              }
            }
          },
          "editor": {
            "type": "string",
            "enum": [
              "grid",
              "cards"
            ]
          }
        },
        "required": [
          "title",
          "columns",
          "rows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "formId",
    "label",
    "definitionRevision",
    "templateRevision",
    "directory",
    "pages",
    "fields",
    "placements",
    "sections",
    "rowGroups"
  ],
  "additionalProperties": false
}
